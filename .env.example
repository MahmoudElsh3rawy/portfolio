# Frontend: where the contact form posts. Leave unset in production (it uses
# the same-origin /api/contact function). Locally, either run `npx vercel dev`
# or point this at a deployed site, e.g. https://mahmoudelsharawy.vercel.app
# VITE_API_URL=

# Serverless function (api/contact.js): set these in Vercel → Settings →
# Environment Variables (and in .env for `vercel dev`)
MONGODB_URI=
RESEND_API_KEY=
